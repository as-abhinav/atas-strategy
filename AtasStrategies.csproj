<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Classic ATAS on Windows runs .NET 10. UseWPF is needed: ATAS colors are WPF types. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AtasStrategies</AssemblyName>
    <RootNamespace>AtasStrategies</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Folder where classic ATAS is installed.
         Override on the command line, e.g.  dotnet build -p:ATAS_BASE="D:\ATAS Platform" -->
    <ATAS_BASE Condition="'$(ATAS_BASE)' == ''">C:\Program Files (x86)\ATAS Platform</ATAS_BASE>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core rules are compiled into this plugin (one DLL, no extra dependency to install).
         Exclude the standalone Core/Tests projects and samples from the plugin build. -->
    <Compile Remove="Core/bin/**;Core/obj/**;Tests/**;Samples/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ATAS.Indicators is the only required reference. -->
    <Reference Include="ATAS.Indicators">
      <HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Chart strategies -->
    <Reference Include="ATAS.Strategies">
      <HintPath>$(ATAS_BASE)\ATAS.Strategies.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Built-in indicators (SMA, EMA, CumulativeDelta, ...) -->
    <Reference Include="ATAS.Indicators.Technical">
      <HintPath>$(ATAS_BASE)\ATAS.Indicators.Technical.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Attributes such as [Parameter] and property editors -->
    <Reference Include="OFT.Attributes">
      <HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Drawing in OnRender -->
    <Reference Include="OFT.Rendering">
      <HintPath>$(ATAS_BASE)\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Logging -->
    <Reference Include="Utils.Common">
      <HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
